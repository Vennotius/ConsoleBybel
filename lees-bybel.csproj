<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LeesBybel</RootNamespace>
    <AssemblyName>lees-bybel</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- gcc and bfd, so clang isn't needed. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <CppCompilerAndLinker>gcc</CppCompilerAndLinker>
    <LinkerFlavor>bfd</LinkerFlavor>
  </PropertyGroup>

  <!-- One resource each: the books ("aov-GEN"), their index ("aov-index"), and the search's
       records, folding, word forms and related words ("search", "fold", "forms", "related"). -->
  <ItemGroup>
    <EmbeddedResource Include="books/*.txt" LogicalName="%(Filename)" />
  </ItemGroup>

</Project>
